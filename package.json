    "axios": "^1.15.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
